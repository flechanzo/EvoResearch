# Copy to .env and fill in locally. .env is a plaintext, ignored file: never
# commit it or include it in a handoff bundle. The API key may instead remain
# in the current PowerShell process environment.
EVORESEARCH_MODEL_BASE_URL=<your-http-or-https-endpoint>
EVORESEARCH_MODEL_API_KEY=<set-locally>
EVORESEARCH_MODEL=<your-model-id>
EVORESEARCH_MODEL_PROVIDER=openai-compatible
EVORESEARCH_MODEL_STRUCTURED_OUTPUT_MODE=prompt_json
EVORESEARCH_MODEL_STREAMING=required
